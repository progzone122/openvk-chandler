parameters:
    level: 0
    paths:
        - chandler/
        - bin/
        - install/
    tmpDir: tmp/phpstan
    bootstrapFiles:
        - stubs/tr.php
    scanFiles:
        - chandler/Bootstrap.php
    excludePaths:
        - chandler/bindata/*
    ignoreErrors:
        -
            # Singleton pattern: the constructor is private, so no subclass
            # can ever be instantiated and `new static()` always creates
            # the declaring class itself.
            identifier: new.static
            path: chandler/Patterns/TSimpleSingleton.php
        -
            # Same reasoning as above: DatabaseConnection is a singleton.
            identifier: new.static
            path: chandler/Database/DatabaseConnection.php
